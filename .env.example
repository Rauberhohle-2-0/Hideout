# The Hono server runs as a sidecar process spawned by the app. It binds
# 127.0.0.1 on an OS-assigned port, and the app gives it an auth token and a
# master key at spawn time — none of which is configurable here.
#
# Where it stores data comes from src/shared/paths.ts (the same location the
# Electron build used), overridable with the HIDEOUT_*_STORE_DIR vars below.

# AI — local providers
# Ollama default is http://127.0.0.1:11434; override only for custom ports
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: proxied Ollama with auth — prefer the encrypted secure-store
# (AES-256-GCM under a key held in the OS keychain), not env. Env is for
# ephemeral dev only:
# HIDEOUT_SECRET_AI_OLLAMA_APIKEY=...

# MCP — Model Context Protocol servers
# Each server uses one transport:
#   STDIO: command + args + env (e.g. npx/uvx for Exa)
#     MCP_STDIO_EXA_COMMAND=npx
#     MCP_STDIO_EXA_ARGS=-y exa-mcp-server
#   HTTP/SSE: url + headers + timeoutSeconds (share same shape; SSE is Streamable HTTP fallback)
#     MCP_HTTP_EXA_URL=http://127.0.0.1:3000/mcp
#     MCP_HTTP_EXA_TIMEOUT_SECONDS=30
# Secrets (API keys) — NEVER commit. Stored locally in the app data directory:
#   mcp-servers.json (0o600, values "***") + secure-store.enc.json, encrypted
#   with AES-256-GCM under a master key kept in the OS keychain.
# For ephemeral dev you may use env overrides (in-memory only, not persisted):
#   HIDEOUT_SECRET_MCP_EXA_ENV_API_KEY=...
#   HIDEOUT_SECRET_MCP_MYHTTP_HEADER_X_API_KEY=...
#
# Exa.ai — free MCP for web search, no API key required (preset auto-seeded):
#   STDIO:  npx -y exa-mcp-server   (or: npx -y exa-mcp-server --tool web_search_exa)
#   HTTP:   set MCP_HTTP_EXA_URL if you self-host exa-mcp-server over HTTP/SSE
# No secret needed for Exa; if your Exa deployment needs a key, store it via the UI
# which writes to the encrypted store — it is never logged and never returned to the interface.
# Custom MCP dir (tests/portable):
#   HIDEOUT_MCP_STORE_DIR=/tmp/my-mcp
#   HIDEOUT_SECURE_STORE_DIR=/tmp/my-secrets

# Logger
# LOG_LEVEL=DEBUG  # DEBUG | INFO | WARN | ERROR | SILENT
# NO_COLOR=  # set to disable colors
