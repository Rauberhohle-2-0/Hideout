{
  "name": "hideout",
  "version": "1.0.0",
  "description": "Secure Vantail + TypeScript project with colored logging",
  "type": "module",
  "private": true,
  "scripts": {
    "build:sidecar": "bun build --compile --outfile public/bin/hideout-server src/server/main.ts",
    "dev": "npm run build:sidecar && vantail build && vantail dev",
    "build": "npm run build:sidecar && vantail build",
    "package": "npm run build:sidecar && vantail package",
    "doctor": "vantail doctor",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vantail/api": "^0.1.17",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.4.0",
    "@vantail/cli": "^0.1.17",
    "@vantail/vite": "^0.1.17",
    "bun": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
