# Hono server — bind is always 127.0.0.1 by default (security: not 0.0.0.0)
# HONO_PORT=3000
# HONO_HOSTNAME=127.0.0.1

# AI — local providers
# Ollama default is http://127.0.0.1:11434; override only for custom ports
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: proxied Ollama with auth — prefer OS keychain (Electron safeStorage)
# via secure-store, not env. Only use env for ephemeral dev:
# HIDEOUT_SECRET_AI_OLLAMA_APIKEY=...

# Logger
# LOG_LEVEL=DEBUG  # DEBUG | INFO | WARN | ERROR | SILENT
# NO_COLOR=  # set to disable colors
